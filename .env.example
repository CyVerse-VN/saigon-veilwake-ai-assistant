# development | staging | production
SVAI_APP_ENV=development
SVAI_SERVICE_NAME=saigon-veilwake-ai-guide
# Required outside development. Replace this temporary shared secret with Game Backend
# signed service-token validation before production.
SVAI_INTERNAL_SERVICE_TOKEN=
SVAI_MAX_AUDIO_BYTES=10485760
SVAI_MAX_AUDIO_SECONDS=90

# Local Dev Voice API + web UI. Disabled by default; never enabled in production.
DEV_VOICE_ENABLED=false
DEV_VOICE_AUDIO_TTL_SECONDS=600
DEV_VOICE_TURN_TIMEOUT_SECONDS=120
DEV_VOICE_SESSION_TTL_SECONDS=3600
DEV_VOICE_MAX_CONCURRENT_TURNS=2
DEV_VOICE_MAX_SESSIONS=100
DEV_VOICE_MAX_TURNS=500

# Groq: use two restricted keys so Generator and Verifier can be rotated/revoked independently.
# Never commit a populated .env or expose either key to the mobile/web client.
GROQ_GENERATOR_API_KEY=
GROQ_VERIFIER_API_KEY=
# Select after the Vietnamese/structured-output benchmark; do not hardcode in domain code.
GROQ_GENERATOR_MODEL=
GROQ_VERIFIER_MODEL=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# Add real providers only to local/deployment secret storage; never commit values.
GEMINI_API_KEY=
# Voice demo: temporary WAV files use ignored .voice_loop_tmp/; see docs for API audio TTL.
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_REQUEST_TIMEOUT_SECONDS=30
# TTS provider: gemini | elevenlabs | vieneu
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_TIMEOUT_SECONDS=30
VIENEU_TTS_BASE_URL=http://127.0.0.1:8001/v1
# Optional on loopback; set a long random secret when VieNeu is reachable from another host.
VIENEU_TTS_API_KEY=
VIENEU_TTS_MODEL=vieneu-v3-turbo
VIENEU_TTS_VOICE=Mai Anh
# VieNeu generates natively at 48 kHz; 24 kHz keeps response WAV files within the dev API limit.
VIENEU_TTS_SAMPLE_RATE=24000
VIENEU_TTS_TIMEOUT_SECONDS=45
# RAG embeddings share GEMINI_API_KEY. Changing model/dimensions requires re-embedding all chunks.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
SUPABASE_URL=
# Server-side key only. Never use the publishable/anon key here and never expose it to a client.
SUPABASE_SECRET_KEY=
# Not used by RAG yet. Retain for later Game Backend/JWT validation only.
SUPABASE_JWKS_URL=
# Not used by this backend. Reserved for a public client that talks to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=
# Optional until migrations/ORM use a direct Postgres driver. Copy the Session pooler URI
# from Supabase Connect; keep the password URL-encoded if it contains special characters.
SUPABASE_DB_URL=
